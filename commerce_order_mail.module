<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;

function commerce_order_mail_help(string $route_name): ?string {
  if ($route_name === "commerce_order_mail.settings") {
    return t("Настройте SMTP и шаблоны писем для уведомлений о заказах Commerce. Поддержка токенов Commerce и обход ограничения Яндекса SMTP с 29.06.2026.");
  }
  return NULL;
}

function commerce_order_mail_page_attachments(array &$attachments): void {
  $path = "";
  try { $path = \Drupal::request()->getPathInfo(); } catch (\Throwable) {}
  if (str_starts_with($path, "/checkout/")) {
    $attachments["#attached"]["library"][] = "commerce_order_mail/checkout-hide";
  }
}

function commerce_order_mail_preprocess_status_messages(array &$variables): void {
  return;
}

function commerce_order_mail_token_info_alter(array &$info): void {
  if (isset($info["tokens"]["commerce_order"])) {
    $info["tokens"]["commerce_order"]["order_items_table"] = [
      "name" => t("Order items table"),
      "description" => t("HTML table with order items: SKU, title, quantity, unit price, total."),
    ];
    $info["tokens"]["commerce_order"]["order_items_text"] = [
      "name" => t("Order items (plain text)"),
      "description" => t("Plain text list of order items."),
    ];
    $info["tokens"]["commerce_order"]["shipping_address"] = [
      "name" => t("Shipping address (formatted)"),
      "description" => t("Formatted shipping address from profile. Works even if standard [commerce_order:shipping_profile] is empty."),
    ];
    $info["tokens"]["commerce_order"]["billing_address"] = [
      "name" => t("Billing address (formatted)"),
      "description" => t("Formatted billing address from profile."),
    ];
    $info["tokens"]["commerce_order"]["shipping_profile_formatted"] = [
      "name" => t("Shipping profile (formatted)"),
      "description" => t("Alias for shipping_address, with HTML line breaks for HTML mails."),
    ];
    $info["tokens"]["commerce_order"]["billing_profile_formatted"] = [
      "name" => t("Billing profile (formatted)"),
      "description" => t("Alias for billing_address."),
    ];
  }
}

function commerce_order_mail_tokens(string $type, array $tokens, array $data, array $options, $bubbleable_metadata): array {
  $replacements = [];
  if ($type === "commerce_order" && !empty($data["commerce_order"])) {
    /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
    $order = $data["commerce_order"];
    $isHtml = !empty($options["sanitize"]) ? FALSE : TRUE;
    if (isset($options["sanitize"]) && $options["sanitize"] === FALSE) {
      $isHtml = TRUE;
    }
    foreach ($tokens as $name => $original) {
      switch ($name) {
        case "order_items_table":
          $replacements[$original] = _commerce_order_mail_build_items_table($order, TRUE);
          break;
        case "order_items_text":
          $replacements[$original] = _commerce_order_mail_build_items_table($order, FALSE);
          break;
        case "shipping_address":
        case "shipping_profile_formatted":
          $replacements[$original] = _commerce_order_mail_render_profile_address($order, "shipping", $isHtml);
          break;
        case "billing_address":
        case "billing_profile_formatted":
          $replacements[$original] = _commerce_order_mail_render_profile_address($order, "billing", $isHtml);
          break;
        case "shipping_profile":
          $val = _commerce_order_mail_render_profile_address($order, "shipping", $isHtml);
          $replacements[$original] = $val !== "" ? $val : t("—", [], ["langcode" => "ru"])->render();
          break;
        case "billing_profile":
          $val = _commerce_order_mail_render_profile_address($order, "billing", $isHtml);
          $replacements[$original] = $val !== "" ? $val : t("—", [], ["langcode" => "ru"])->render();
          break;
      }
    }
  }
  return $replacements;
}

function _commerce_order_mail_get_profile($order, string $kind) {
  $candidates = [];
  if ($kind === "billing") {
    if (method_exists($order, "getBillingProfile")) {
      try { $p = $order->getBillingProfile(); if ($p) { $candidates[] = $p; } } catch (\Throwable) {}
    }
    foreach (["billing_profile", "billing_information", "profile", "customer_profile"] as $field) {
      if ($order->hasField($field) && !$order->get($field)->isEmpty()) {
        $e = $order->get($field)->entity;
        if ($e) { $candidates[] = $e; }
      }
    }
  }
  else {
    if (method_exists($order, "getShippingProfile")) {
      try { $p = $order->getShippingProfile(); if ($p) { $candidates[] = $p; } } catch (\Throwable) {}
    }
    foreach (["shipping_profile", "shipping_information", "shipment", "shipments"] as $field) {
      if ($order->hasField($field) && !$order->get($field)->isEmpty()) {
        $val = $order->get($field);
        foreach ($val as $item) {
          $e = $item->entity ?? NULL;
          if ($e) {
            if ($e->getEntityTypeId() === "profile") { $candidates[] = $e; }
            elseif ($e->hasField("shipping_profile") && !$e->get("shipping_profile")->isEmpty()) {
              $candidates[] = $e->get("shipping_profile")->entity;
            }
          }
        }
      }
    }
    if (empty($candidates) && \Drupal::hasService("entity_type.manager")) {
      try {
        $storage = \Drupal::entityTypeManager()->getStorage("profile");
        $q = $storage->getQuery()->accessCheck(FALSE)->condition("type", "customer", "IN")->sort("profile_id", "DESC")->range(0, 5)->execute();
        // Try to find profile linked via order's data or recent.
      } catch (\Throwable) {}
    }
  }
  foreach ($candidates as $c) {
    if ($c) { return $c; }
  }
  return NULL;
}

function _commerce_order_mail_render_profile_address($order, string $kind, bool $html): string {
  $profile = _commerce_order_mail_get_profile($order, $kind);
  if (!$profile) {
    if ($kind === "shipping") {
      $profile = _commerce_order_mail_get_profile($order, "billing");
    }
    if (!$profile) { return ""; }
  }
  $lines = [];
  $phone = "";
  foreach (["field_phone", "telephone", "phone", "field_telephone"] as $f) {
    if ($profile->hasField($f) && !$profile->get($f)->isEmpty()) {
      $phone = (string) $profile->get($f)->value;
      if ($phone !== "") { break; }
    }
  }
  $address = NULL;
  if ($profile->hasField("address") && !$profile->get("address")->isEmpty()) {
    $address = $profile->get("address")->first();
  }
  elseif ($profile->hasField("field_address") && !$profile->get("field_address")->isEmpty()) {
    $address = $profile->get("field_address")->first();
  }
  if ($address) {
    $vals = $address->getValue();
    $given = trim(($vals["given_name"] ?? "") . " " . ($vals["family_name"] ?? ""));
    $org = $vals["organization"] ?? "";
    if ($given !== "") { $lines[] = $given; }
    if ($org !== "") { $lines[] = $org; }
    if ($phone !== "") { $lines[] = $phone; }
    foreach (["address_line1", "address_line2", "locality", "administrative_area", "postal_code"] as $k) {
      if (!empty($vals[$k])) { $lines[] = $vals[$k]; }
    }
    $country = $vals["country_code"] ?? "";
    if ($country !== "") {
      try {
        $countries = \Drupal::service("address.country_repository")->getList();
        $lines[] = $countries[$country] ?? $country;
      } catch (\Throwable) { $lines[] = $country; }
    }
  }
  else {
    if ($phone !== "") { $lines[] = $phone; }
    if ($profile->hasField("field_full_name") && !$profile->get("field_full_name")->isEmpty()) {
      $lines[] = (string) $profile->get("field_full_name")->value;
    }
    elseif (method_exists($profile, "label")) {
      $label = $profile->label();
      if ($label) { $lines[] = $label; }
    }
  }
  if (empty($lines)) { return ""; }
  if ($html) {
    return implode("<br>", array_map(fn($l) => htmlspecialchars($l, ENT_QUOTES, "UTF-8"), $lines));
  }
  return implode("\n", $lines);
}

function _commerce_order_mail_build_items_table($order, bool $html): string {
  if (!$order->hasField("order_items") || $order->get("order_items")->isEmpty()) {
    return $html ? "<p>" . t("No items") . "</p>" : (string) t("No items");
  }
  $items = $order->getItems();
  if ($html) {
    $rows = "";
    foreach ($items as $item) {
      $title = $item->getTitle();
      $qty = $item->getQuantity();
      $unit = $item->getUnitPrice() ? \Drupal::service("commerce_price.currency_formatter")->format($item->getUnitPrice()->getNumber(), $item->getUnitPrice()->getCurrencyCode()) : "-";
      $total = $item->getTotalPrice() ? \Drupal::service("commerce_price.currency_formatter")->format($item->getTotalPrice()->getNumber(), $item->getTotalPrice()->getCurrencyCode()) : "-";
      $sku = "";
      $purchased = $item->getPurchasedEntity();
      if ($purchased && $purchased->hasField("sku")) {
        $sku = $purchased->getSku();
      }
      $rows .= "<tr><td>" . htmlspecialchars((string) $sku) . "</td><td>" . htmlspecialchars((string) $title) . "</td><td style=\"text-align:center\">" . htmlspecialchars((string) $qty) . "</td><td style=\"text-align:right\">" . htmlspecialchars((string) $unit) . "</td><td style=\"text-align:right\">" . htmlspecialchars((string) $total) . "</td></tr>";
    }
    $totalPrice = $order->getTotalPrice();
    $totalFormatted = $totalPrice ? \Drupal::service("commerce_price.currency_formatter")->format($totalPrice->getNumber(), $totalPrice->getCurrencyCode()) : "-";
    return "<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%\">" .
      "<thead><tr><th>SKU</th><th>" . t("Product") . "</th><th>" . t("Qty") . "</th><th>" . t("Unit price") . "</th><th>" . t("Total") . "</th></tr></thead>" .
      "<tbody>" . $rows . "</tbody>" .
      "<tfoot><tr><td colspan=\"4\" style=\"text-align:right\"><strong>" . t("Order total") . "</strong></td><td style=\"text-align:right\"><strong>" . htmlspecialchars($totalFormatted) . "</strong></td></tr></tfoot>" .
      "</table>";
  }
  $lines = [];
  foreach ($items as $item) {
    $lines[] = sprintf("%s x %s — %s", $item->getTitle(), $item->getQuantity(), $item->getTotalPrice() ? $item->getTotalPrice()->__toString() : "-");
  }
  $totalPrice = $order->getTotalPrice();
  if ($totalPrice) {
    $lines[] = t("Order total: @total", ["@total" => $totalPrice->__toString()])->render();
  }
  return implode("\n", $lines);
}
